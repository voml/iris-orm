{
    "name": "@yydb/iris-adapter-postgres",
    "version": "0.1.0",
    "description": "Iris foreign-store adapter for PostgreSQL via postgres.js (pure JS)",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "src",
        "README.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@yydb/iris": "workspace:*"
    },
    "peerDependencies": {
        "postgres": "^3.4.0"
    },
    "peerDependenciesMeta": {
        "postgres": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^5.9.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
