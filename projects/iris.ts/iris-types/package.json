{
    "name": "@yydb/iris-types",
    "version": "0.1.0",
    "description": "Iris TypeScript types — pairs with Rust iris-types (native, not FFI)",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
