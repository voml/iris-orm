            "default": "./src/index.ts"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "typescript": "^5.9.2"
    }
}
