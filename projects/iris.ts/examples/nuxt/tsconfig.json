{
    "extends": "./.nuxt/tsconfig.server.json",
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "types": ["node"]
    },
    "include": [
        "./.nuxt/types/nitro.d.ts",
        "./.nuxt/types/nitro-nuxt.d.ts",
        "server/**/*.ts",
        "nuxt.config.ts",
        "app.vue",
        "iris.config.ts"
    ]
}
