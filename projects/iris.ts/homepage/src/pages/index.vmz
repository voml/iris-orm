<template>
  <div class="site landing">
    <SiteHeader />
    <main>
      <section class="hero" aria-label="Introduction">
        <div class="hero-inner">
          <div class="hero-copy">
            <Badge tone="brand">{heroKickerLabel}</Badge>
            <h1>{heroTitleLabel}</h1>
            <p class="lede">{heroLedeLabel}</p>
            <div class="cta-row">
              <Button type="button" onClick={() => this.go(guideHref)}>{ctaInstallLabel}</Button>
              <Link href={docsRootHref}>{ctaDocsLabel}</Link>
              <Link href={githubUrl} target="_blank" rel="noopener noreferrer">{ctaGithubLabel}</Link>
            </div>
          </div>
          <aside class="hero-panel" aria-label="Import paths">
            <CodeBlock code={codeSample} caption="@yydb/iris · hosts" />
          </aside>
        </div>
      </section>

      <section class="hosts" aria-labelledby="hosts-title">
        <h2 id="hosts-title">{hostsTitleLabel}</h2>
        <div class="hosts-grid">
          <Card title={hostsNodeLabel} description={hostsNodeDescLabel} hoverable={true} />
          <Card title={hostsWebLabel} description={hostsWebDescLabel} hoverable={true} />
        </div>
      </section>

      <section class="pipeline" aria-labelledby="pipeline-title">
        <h2 id="pipeline-title">{pipelineTitleLabel}</h2>
        <Steps label={pipelineTitleLabel} current="core" items={pipelineSteps} />
        <p class="pipeline-note">{pipelineNoteLabel}</p>
      </section>
    </main>
    <SiteFooter />
  </div>
</template>

<script client>
import {
  heroKicker,
  heroTitle,
  heroLede,
  ctaDocs,
  ctaGithub,
  ctaInstall,
  hostsTitle,
  hostsNode,
  hostsNodeDesc,
  hostsWeb,
  hostsWebDesc,
  pipelineTitle,
  pipelineSchema,
  pipelineCore,
  pipelineNode,
  pipelineWasm,
  pipelineNote,
} from '#locales/common';
import { githubUrl } from '../lib/site.js';
import { docsPaths, readLocaleId, watchDocumentLocale, withLocaleHint } from '../lib/locale-copy.js';

export default class IndexPage {
  heroKickerLabel = '';
  heroTitleLabel = '';
  heroLedeLabel = '';
  ctaDocsLabel = '';
  ctaGithubLabel = '';
  ctaInstallLabel = '';
  hostsTitleLabel = '';
  hostsNodeLabel = '';
  hostsNodeDescLabel = '';
  hostsWebLabel = '';
  hostsWebDescLabel = '';
  pipelineTitleLabel = '';
  pipelineNoteLabel = '';
  pipelineSteps = [];
  docsRootHref = '/d/zh-hans/';
  guideHref = '/d/zh-hans/guide/getting-started';
  githubUrl = githubUrl;
  codeSample =
    'import type { IrisRuntime } from "@yydb/iris/types";\n\n// browser default\nimport { createIris } from "@yydb/iris";\n\n// node / SSR / CLI\nimport { createIris } from "@yydb/iris/node";';
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.heroKickerLabel = heroKicker();
    this.heroTitleLabel = heroTitle();
    this.heroLedeLabel = heroLede();
    this.ctaDocsLabel = ctaDocs();
    this.ctaGithubLabel = ctaGithub();
    this.ctaInstallLabel = ctaInstall();
    this.hostsTitleLabel = hostsTitle();
    this.hostsNodeLabel = hostsNode();
    this.hostsNodeDescLabel = hostsNodeDesc();
    this.hostsWebLabel = hostsWeb();
    this.hostsWebDescLabel = hostsWebDesc();
    this.pipelineTitleLabel = pipelineTitle();
    this.pipelineNoteLabel = pipelineNote();
    const schema = pipelineSchema();
    const core = pipelineCore();
    const node = pipelineNode();
    const wasm = pipelineWasm();
    this.pipelineSteps = [
      { id: 'schema', index: '1', title: schema, status: 'done' },
      { id: 'core', index: '2', title: core, status: 'current' },
      {
        id: 'hosts',
        index: '3',
        title: `${node} / ${wasm}`,
        status: 'upcoming',
      },
    ];
    const paths = docsPaths(readLocaleId());
    this.docsRootHref = paths.docsRootHref;
    this.guideHref = paths.guideHref;
  }

  applyLocaleCopy(preferred) {
    withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
  }

  go(href) {
    const loc = typeof window !== 'undefined' ? window.location : null;
    if (loc && typeof loc.assign === 'function') loc.assign(href);
  }
}
</script>
