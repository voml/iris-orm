<template>
  <div class="site landing">
    <SiteHeader />
    <main>
      <section class="hero" aria-label="Introduction">
        <div class="hero-inner">
          <div class="hero-copy">
            <Badge tone="brand">{heroKickerLabel}</Badge>
            <h1>{heroTitleLabel}</h1>
            <p class="lede">{heroLedeLabel}</p>
            <div class="cta-row">
              <Button type="button" onClick={() => this.go(guideHref)}>{ctaInstallLabel}</Button>
              <Link href="/playground">{ctaPlaygroundLabel}</Link>
              <Link href={docsRootHref}>{ctaDocsLabel}</Link>
              <Link href={githubUrl} target="_blank" rel="noopener noreferrer">{ctaGithubLabel}</Link>
            </div>
          </div>
          <HeroCodePanel code={codeSample} caption={codeCaptionLabel} copyLabel={copyLabel} />
        </div>
      </section>

      <section class="hosts" aria-labelledby="hosts-title">
        <h2 id="hosts-title">{hostsTitleLabel}</h2>
        <div class="hosts-grid">
          <Card title={hostsNodeLabel} description={hostsNodeDescLabel} hoverable={true} />
          <Card title={hostsWebLabel} description={hostsWebDescLabel} hoverable={true} />
        </div>
      </section>

      <section class="pipeline" aria-labelledby="pipeline-title">
        <h2 id="pipeline-title">{pipelineTitleLabel}</h2>
        <Steps label={pipelineTitleLabel} current="core" items={pipelineSteps} />
        <p class="pipeline-note">{pipelineNoteLabel}</p>
      </section>
    </main>
    <SiteFooter />
  </div>
</template>

<script client>
import {
  heroKicker,
  heroTitle,
  heroLede,
  ctaDocs,
  ctaGithub,
  ctaInstall,
  ctaPlayground,
  hostsTitle,
  hostsNode,
  hostsNodeDesc,
  hostsWeb,
  hostsWebDesc,
  pipelineTitle,
  pipelineSchema,
  pipelineCore,
  pipelineNode,
  pipelineWasm,
  pipelineNote,
  copyCode,
} from '#locales/common';
import { githubUrl } from '../lib/site.js';
import { docsPaths, readLocaleId, watchDocumentLocale, withLocaleHint } from '../lib/locale-copy.js';
import { DEFAULT_LOCALE, bootLocaleCopy } from '../lib/boot-locale.js';

function landingCopy(localeId) {
  return bootLocaleCopy(localeId, () => {
    const schema = pipelineSchema();
    const core = pipelineCore();
    const node = pipelineNode();
    const wasm = pipelineWasm();
    const paths = docsPaths(localeId);
    return {
      heroKickerLabel: heroKicker(),
      heroTitleLabel: heroTitle(),
      heroLedeLabel: heroLede(),
      ctaDocsLabel: ctaDocs(),
      ctaGithubLabel: ctaGithub(),
      ctaInstallLabel: ctaInstall(),
      ctaPlaygroundLabel: ctaPlayground(),
      hostsTitleLabel: hostsTitle(),
      hostsNodeLabel: hostsNode(),
      hostsNodeDescLabel: hostsNodeDesc(),
      hostsWebLabel: hostsWeb(),
      hostsWebDescLabel: hostsWebDesc(),
      pipelineTitleLabel: pipelineTitle(),
      pipelineNoteLabel: pipelineNote(),
      codeCaptionLabel: 'import paths',
      copyLabel: copyCode(),
      pipelineSteps: [
        { id: 'schema', index: '1', title: schema, status: 'done' },
        { id: 'core', index: '2', title: core, status: 'current' },
        { id: 'hosts', index: '3', title: `${node} / ${wasm}`, status: 'upcoming' },
      ],
      docsRootHref: paths.docsRootHref,
      guideHref: paths.guideHref,
    };
  });
}

const boot = landingCopy(DEFAULT_LOCALE);

export default class IndexPage {
  heroKickerLabel = boot.heroKickerLabel;
  heroTitleLabel = boot.heroTitleLabel;
  heroLedeLabel = boot.heroLedeLabel;
  ctaDocsLabel = boot.ctaDocsLabel;
  ctaGithubLabel = boot.ctaGithubLabel;
  ctaInstallLabel = boot.ctaInstallLabel;
  ctaPlaygroundLabel = boot.ctaPlaygroundLabel;
  hostsTitleLabel = boot.hostsTitleLabel;
  hostsNodeLabel = boot.hostsNodeLabel;
  hostsNodeDescLabel = boot.hostsNodeDescLabel;
  hostsWebLabel = boot.hostsWebLabel;
  hostsWebDescLabel = boot.hostsWebDescLabel;
  pipelineTitleLabel = boot.pipelineTitleLabel;
  pipelineNoteLabel = boot.pipelineNoteLabel;
  codeCaptionLabel = boot.codeCaptionLabel;
  copyLabel = boot.copyLabel;
  pipelineSteps = boot.pipelineSteps;
  docsRootHref = boot.docsRootHref;
  guideHref = boot.guideHref;
  githubUrl = githubUrl;
  codeSample =
    'import type { IrisRuntime } from "@yydb/iris/types";\n\n// browser default\nimport { createIris } from "@yydb/iris";\n\n// node / SSR / CLI\nimport { createIris } from "@yydb/iris/node";';
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    Object.assign(this, landingCopy(readLocaleId()));
  }

  applyLocaleCopy(preferred) {
    withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
  }

  go(href) {
    const loc = typeof window !== 'undefined' ? window.location : null;
    if (loc && typeof loc.assign === 'function') loc.assign(href);
  }
}
</script>
