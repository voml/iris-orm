<template>
  <header class="site-header" data-home={home ? 'true' : 'false'}>
    <Link href="/">
      <span class="site-brand">
        <Icon name="nav.home" size="sm" label={navHomeLabel} />
        <span>{brandLabel}</span>
      </span>
    </Link>
    <nav class="site-nav" aria-label="Primary">
      <Link href="/">{navHomeLabel}</Link>
      <Link href={docsRootHref}>{navDocsLabel}</Link>
      <details class="site-language">
        <summary aria-label={selectLanguageLabel}>
          <Icon name="tool.ascii" size="sm" label={selectLanguageLabel} />
        </summary>
        <div class="site-language__menu">
          <Button
            type="button"
            variant="ghost"
            aria-current={localeId === 'zh-hans' ? 'true' : null}
            onClick={() => this.switchLocale('zh-hans')}
          >
            {langZhLabel}
          </Button>
          <Button
            type="button"
            variant="ghost"
            aria-current={localeId === 'en-us' ? 'true' : null}
            onClick={() => this.switchLocale('en-us')}
          >
            {langEnLabel}
          </Button>
        </div>
      </details>
      <Link href={githubUrl} target="_blank" rel="noopener noreferrer">{navGithubLabel}</Link>
    </nav>
  </header>
</template>

<script client>
import {
  brand,
  navHome,
  navDocs,
  navGithub,
  selectLanguage,
  langZh,
  langEn,
} from '#locales/common';
import { githubUrl } from '../lib/site.js';
import { docsPaths, readLocaleId, watchDocumentLocale, withLocaleHint } from '../lib/locale-copy.js';

export default class SiteHeader {
  home = false;
  localeId = 'zh-hans';
  brandLabel = '';
  navHomeLabel = '';
  navDocsLabel = '';
  navGithubLabel = '';
  selectLanguageLabel = '';
  langZhLabel = '';
  langEnLabel = '';
  docsRootHref = '/d/zh-hans/';
  githubUrl = githubUrl;
  _unwatchLocale = null;

  onMount() {
    this.syncHome();
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  syncHome() {
    // static-cdn SSR may define `window` without `location`
    const loc = typeof window !== 'undefined' ? window.location : null;
    if (!loc || typeof loc.pathname !== 'string') return;
    this.home = loc.pathname === '/';
  }

  refreshCopy() {
    this.brandLabel = brand();
    this.navHomeLabel = navHome();
    this.navDocsLabel = navDocs();
    this.navGithubLabel = navGithub();
    this.selectLanguageLabel = selectLanguage();
    this.langZhLabel = langZh();
    this.langEnLabel = langEn();
    this.docsRootHref = docsPaths(this.localeId).docsRootHref;
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  async switchLocale(to) {
    if (typeof window === 'undefined') return;
    const fn = window.__vmzTransitionLocale;
    if (typeof fn !== 'function') {
      this.applyLocaleCopy(to);
      return;
    }
    const r = await fn(to);
    if (r && r.status === 'committed') {
      this.applyLocaleCopy(to);
      queueMicrotask(() => this.applyLocaleCopy(to));
    }
  }
}
</script>
