{
    "name": "@yydb/iris",
    "version": "0.1.0",
    "description": "Iris ORM — TypeScript facade + iris CLI for VOS data access",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "bin": {
        "iris": "./src/cli.ts"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "iris": "node ./src/cli.ts"
    },
    "dependencies": {
        "@game-gpt/vos-ast": "file:../../../../vos-language/projects/vos.ts/vos-ast",
        "@game-gpt/vos-parser": "file:../../../../vos-language/projects/vos.ts/vos-parser",
        "@yydb/iris-types": "workspace:*",
        "cac": "^6.7.14"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    }
}
