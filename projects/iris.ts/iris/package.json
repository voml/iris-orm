{
    "name": "@yydb/iris",
    "version": "0.1.0",
    "description": "Iris ORM — TypeScript facade + iris CLI for VOS data access",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/browser/index.ts",
            "browser": "./src/browser/index.ts",
            "default": "./src/browser/index.ts"
        },
        "./node": {
            "types": "./src/node/index.ts",
            "node": "./src/node/index.ts",
            "default": "./src/node/unsupported.ts"
        },
        "./types": {
            "types": "./src/types/index.ts",
            "default": "./src/types/index.ts"
        },
        "./node/tooling": {
            "types": "./src/node/tooling.ts",
            "node": "./src/node/tooling.ts",
            "default": "./src/node/unsupported.ts"
        }
    },
    "bin": {
        "iris": "./bin/iris.ts"
    },
    "files": [
        "bin",
        "src"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "iris": "node ./bin/iris.ts",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\""
    },
    "dependencies": {
        "cac": "^6.7.14"
    },
    "optionalDependencies": {
        "@yydb/iris-linux-x64": "workspace:*",
        "@yydb/iris-unknown-wasm32": "workspace:*",
        "@yydb/iris-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    }
}
