{
    "name": "@yydb/iris-wasm",
    "private": true,
    "version": "0.1.0",
    "description": "Private wasm-pack build workspace for @yydb/iris (not published)",
    "license": "MPL-2.0",
    "type": "module",
    "scripts": {
        "build": "wasm-pack build --release --target web --out-name iris.unknown-wasm32 --out-dir ../iris-unknown-wasm32/pkg-staging ../../iris.rs/iris-wasm && node ./scripts/copy-artifacts.mjs",
        "build:debug": "wasm-pack build --target web --out-name iris.unknown-wasm32 --out-dir ../iris-unknown-wasm32/pkg-staging ../../iris.rs/iris-wasm && node ./scripts/copy-artifacts.mjs",
        "test": "node ./scripts/smoke.mjs"
    },
    "engines": {
        "node": ">=18"
    }
}
