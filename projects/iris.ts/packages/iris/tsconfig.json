{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "declaration": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "allowJs": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.mts", "src/**/*.mjs", "tests/**/*.ts"],
    "exclude": [
        "tests/codegen-g0/positive",
        "tests/codegen-g0/negative",
        "tests/generated-e2e-runner.ts",
        "tests/generated-project-e2e-runner.ts"
    ]
}
