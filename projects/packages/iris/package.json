{
    "name": "@yydb/iris",
    "version": "0.0.5",
    "description": "Iris ORM — TypeScript facade + iris CLI. Rust semantic core via N-API / WASM. Site: https://iris-orm.pages.dev/",
    "homepage": "https://iris-orm.pages.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/iris-orm.git",
        "directory": "projects/packages/iris"
    },
    "bugs": {
        "url": "https://github.com/voml/iris-orm/issues"
    },
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/browser/index.ts",
            "browser": "./src/browser/index.ts",
            "default": "./src/browser/index.ts"
        },
        "./node": {
            "types": "./src/node/index.ts",
            "node": "./src/node/index.ts",
            "default": "./src/node/unsupported.ts"
        },
        "./wasm": {
            "types": "./src/wasm/index.ts",
            "browser": "./src/wasm/index.ts",
            "default": "./src/wasm/index.ts"
        },
        "./types": {
            "types": "./src/types/index.ts",
            "default": "./src/types/index.ts"
        },
        "./node/tooling": {
            "types": "./src/node/tooling.ts",
            "node": "./src/node/tooling.ts",
            "default": "./src/node/unsupported.ts"
        }
    },
    "bin": {
        "iris": "./bin/iris.mjs"
    },
    "files": [
        "bin",
        "src"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "iris": "node ./bin/iris.mjs",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\""
    },
    "dependencies": {
        "@vmz/commander": "^0.2.0",
        "@yydb/iris-unknown-wasm32": "workspace:*",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@yydb/iris-darwin-arm64": "workspace:*",
        "@yydb/iris-darwin-x64": "workspace:*",
        "@yydb/iris-linux-arm64": "workspace:*",
        "@yydb/iris-linux-x64": "workspace:*",
        "@yydb/iris-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    }
}
