{
    "name": "@yydb/iris",
    "version": "0.0.6",
    "description": "Iris ORM — VOS data-access layer for Node.js and browsers (N-API + WASM facades, iris CLI)",
    "homepage": "https://iris-orm.pages.dev/",
    "keywords": ["iris", "orm", "vos", "yydb", "wasm", "napi", "typescript"],
    "readme": "README.md",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/iris-orm.git",
        "directory": "projects/packages/iris"
    },
    "bugs": {
        "url": "https://github.com/voml/iris-orm/issues"
    },
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "types": "./src/browser/index.ts",
    "typesVersions": {
        "*": {
            "types": ["./src/types/index.ts"],
            "node": ["./src/node/index.ts"],
            "wasm": ["./src/wasm/index.ts"],
            "cloudflare": ["./src/cloudflare/index.ts"],
            "node/tooling": ["./src/node/tooling.ts"]
        }
    },
    "exports": {
        ".": {
            "types": "./src/browser/index.ts",
            "browser": "./dist/browser/index.js",
            "default": "./dist/browser/index.js"
        },
        "./node": {
            "types": "./src/node/index.ts",
            "node": "./dist/node/index.js",
            "default": "./dist/node/unsupported.js"
        },
        "./wasm": {
            "types": "./src/wasm/index.ts",
            "browser": "./dist/wasm/index.js",
            "default": "./dist/wasm/index.js"
        },
        "./types": {
            "types": "./src/types/index.ts",
            "default": "./dist/types/index.js"
        },
        "./cloudflare": {
            "types": "./src/cloudflare/index.ts",
            "workerd": "./dist/cloudflare/index.js",
            "default": "./dist/cloudflare/index.js"
        },
        "./node/tooling": {
            "types": "./src/node/tooling.ts",
            "node": "./dist/node/tooling.js",
            "default": "./dist/node/unsupported.js"
        }
    },
    "bin": {
        "iris": "./bin/iris.mjs"
    },
    "files": [
        "bin",
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "prepublishOnly": "node ./scripts/build-dist.mjs",
        "build": "node ./scripts/build-dist.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "iris": "node ./bin/iris.mjs",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\""
    },
    "dependencies": {
        "@vmz/commander": "^0.2.0",
        "@yydb/iris-unknown-wasm32": "workspace:*",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@yydb/iris-darwin-arm64": "workspace:*",
        "@yydb/iris-darwin-x64": "workspace:*",
        "@yydb/iris-linux-arm64": "workspace:*",
        "@yydb/iris-linux-x64": "workspace:*",
        "@yydb/iris-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    }
}
