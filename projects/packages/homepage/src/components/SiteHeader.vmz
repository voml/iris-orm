<template>
  <header class="site-header" data-vmz-fixture="site-header" data-home={home ? 'true' : 'false'}>
    <Link href="/">
      <span class="site-brand">{brandLabel}</span>
    </Link>
    <nav class="site-nav" aria-label="Primary">
      <Link href="/">{navHomeLabel}</Link>
      <Link href={docsRootHref}>{navDocsLabel}</Link>
      <Link href="/playground">{navPlaygroundLabel}</Link>
      <div class="locale-switch" role="group" aria-label={selectLanguageLabel}>
        <button
          type="button"
          class={localeId === 'zh-hans' ? 'locale-switch__btn is-active' : 'locale-switch__btn'}
          aria-current={localeId === 'zh-hans' ? 'true' : null}
          onClick={() => this.switchLocale('zh-hans')}
        >
          {langZhLabel}
        </button>
        <button
          type="button"
          class={localeId === 'en-us' ? 'locale-switch__btn is-active' : 'locale-switch__btn'}
          aria-current={localeId === 'en-us' ? 'true' : null}
          onClick={() => this.switchLocale('en-us')}
        >
          {langEnLabel}
        </button>
      </div>
      <Link href={githubUrl} target="_blank" rel="noopener noreferrer">{navGithubLabel}</Link>
    </nav>
  </header>
</template>

<script client>
import {
  brand,
  navHome,
  navDocs,
  navPlayground,
  navGithub,
  selectLanguage,
  langZh,
  langEn,
} from '#locales/common';
import { githubUrl } from '../lib/site.js';
import { docsPaths, readLocaleId, watchDocumentLocale, withLocaleHint } from '../lib/locale-copy.js';
import { DEFAULT_LOCALE, bootLocaleCopy } from '../lib/boot-locale.js';

function headerCopy(localeId) {
  return bootLocaleCopy(localeId, () => ({
    brandLabel: brand(),
    navHomeLabel: navHome(),
    navDocsLabel: navDocs(),
    navPlaygroundLabel: navPlayground(),
    navGithubLabel: navGithub(),
    selectLanguageLabel: selectLanguage(),
    langZhLabel: langZh(),
    langEnLabel: langEn(),
    docsRootHref: docsPaths().docsRootHref,
  }));
}

const boot = headerCopy(DEFAULT_LOCALE);

export default class SiteHeader {
  home = false;
  localeId = DEFAULT_LOCALE;
  brandLabel = boot.brandLabel;
  navHomeLabel = boot.navHomeLabel;
  navDocsLabel = boot.navDocsLabel;
  navPlaygroundLabel = boot.navPlaygroundLabel;
  navGithubLabel = boot.navGithubLabel;
  selectLanguageLabel = boot.selectLanguageLabel;
  langZhLabel = boot.langZhLabel;
  langEnLabel = boot.langEnLabel;
  docsRootHref = boot.docsRootHref;
  githubUrl = githubUrl;
  _unwatchLocale = null;

  onMount() {
    this.syncHome();
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  syncHome() {
    const loc = typeof window !== 'undefined' ? window.location : null;
    if (!loc || typeof loc.pathname !== 'string') return;
    this.home = loc.pathname === '/';
  }

  refreshCopy() {
    Object.assign(this, headerCopy(readLocaleId()));
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  async switchLocale(to) {
    if (typeof window === 'undefined') return;
    const fn = window.__vmzTransitionLocale;
    if (typeof fn === 'function') {
      const r = await fn(to, { reload: true });
      if (r && r.status === 'committed') {
        this.applyLocaleCopy(to);
      }
      return;
    }
    try {
      localStorage.setItem('vmz.locale', to);
      document.cookie = `vmz.locale=${encodeURIComponent(to)}; path=/; max-age=31536000; SameSite=Lax`;
    } catch {
      /* ignore */
    }
    window.location.reload();
  }
}
</script>
