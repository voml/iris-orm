<template>
  <footer class="site-footer" data-vmz-fixture="site-footer">
    <div class="site-footer__accent" aria-hidden="true"></div>
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <p class="site-footer__mark">{brandFullLabel}</p>
        <p class="site-footer__tagline">{footerTagLabel}</p>
        <p class="site-footer__scope">{footerScopeLabel}</p>
        <p class="site-footer__copy">{footerCopyrightLabel}</p>
      </div>
      <div class="site-footer__columns">
        <div class="site-footer__col">
          <p class="site-footer__col-title">{footerColProductLabel}</p>
          <nav class="site-footer__nav" aria-label="Product">
            <Link href="/playground">{navPlaygroundLabel}</Link>
            <Link href={docsRootHref}>{navDocsLabel}</Link>
            <Link href={guideHref}>{footerGuideLabel}</Link>
          </nav>
        </div>
        <div class="site-footer__col">
          <p class="site-footer__col-title">{footerColProjectLabel}</p>
          <nav class="site-footer__nav" aria-label="Project">
            <Link href={githubUrl} target="_blank" rel="noopener noreferrer">{navGithubLabel}</Link>
          </nav>
        </div>
      </div>
    </div>
  </footer>
</template>

<script client>
import {
  brand,
  footerTag,
  footerScopeNote,
  footerCopyright,
  navDocs,
  navGithub,
  navPlayground,
  footerGuide,
  footerColProduct,
  footerColProject,
} from '#locales/common';
import { githubUrl } from '../lib/site.js';
import { docsPaths, readLocaleId, watchDocumentLocale, withLocaleHint } from '../lib/locale-copy.js';
import { DEFAULT_LOCALE, bootLocaleCopy } from '../lib/boot-locale.js';

function footerCopy(localeId) {
  return bootLocaleCopy(localeId, () => {
    const paths = docsPaths();
    return {
      brandFullLabel: `${brand()} ORM`,
      footerTagLabel: footerTag(),
      footerScopeLabel: footerScopeNote(),
      footerCopyrightLabel: footerCopyright(),
      navDocsLabel: navDocs(),
      navGithubLabel: navGithub(),
      navPlaygroundLabel: navPlayground(),
      footerGuideLabel: footerGuide(),
      footerColProductLabel: footerColProduct(),
      footerColProjectLabel: footerColProject(),
      docsRootHref: paths.docsRootHref,
      guideHref: paths.guideHref,
    };
  });
}

const boot = footerCopy(DEFAULT_LOCALE);

export default class SiteFooter {
  localeId = DEFAULT_LOCALE;
  brandFullLabel = boot.brandFullLabel;
  footerTagLabel = boot.footerTagLabel;
  footerScopeLabel = boot.footerScopeLabel;
  footerCopyrightLabel = boot.footerCopyrightLabel;
  navDocsLabel = boot.navDocsLabel;
  navGithubLabel = boot.navGithubLabel;
  navPlaygroundLabel = boot.navPlaygroundLabel;
  footerGuideLabel = boot.footerGuideLabel;
  footerColProductLabel = boot.footerColProductLabel;
  footerColProjectLabel = boot.footerColProjectLabel;
  docsRootHref = boot.docsRootHref;
  guideHref = boot.guideHref;
  githubUrl = githubUrl;
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    Object.assign(this, footerCopy(readLocaleId()));
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }
}
</script>
