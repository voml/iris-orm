{
    "name": "@yydb/iris-unknown-wasm32",
    "version": "0.1.0",
    "description": "Browser WebAssembly binary for @yydb/iris",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": ["./lib/iris_wasm.js"],
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./wasm": "./lib/iris_wasm_bg.wasm"
    },
    "files": [
        "src",
        "lib",
        "readme.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\""
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
