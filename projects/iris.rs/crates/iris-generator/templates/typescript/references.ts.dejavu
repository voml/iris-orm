<%- loop table in tables_view %>
declare const __iris<% table.name %>IdBrand: unique symbol;

/** Branded primary key for <% table.name %>. */
export type <% table.name %>Id = <% table.pk_ts_scalar %> & {
    readonly [__iris<% table.name %>IdBrand]: true;
};

/** Convert an external scalar into this schema's branded identity. */
export function <% table.camel_name %>Id(value: <% table.pk_ts_scalar %>): <% table.name %>Id {
    return value as <% table.name %>Id;
}

/** Stored reference identity for &<% table.name %> (not an ORM relation object). */
export type <% table.name %>Reference = {
    readonly __irisRef: "<% table.name %>";
    <% table.pk_ts_name %>: <% table.name %>Id;
};

/** Values accepted when writing &<% table.name %>. */
export type <% table.name %>RefInput =
    | <% table.name %>Id
    | { <% table.pk_ts_name %>: <% table.name %>Id }
    | <% table.name %>Reference;

<%- end loop %>
