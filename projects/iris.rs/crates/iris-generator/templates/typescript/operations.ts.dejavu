import type { OperationExecutor } from "@yydb/iris/types";
import {
    buildDeclaredOperationRequest,
    synthesizeCreate,
    synthesizeDelete,
    synthesizeUpdate,
    synthesizeFindFirst,
    synthesizeFindMany,
    synthesizeFindUnique,
    synthesizeMacroCall,
    throwOperationEnvelopeError,
} from "./_internal/synthesize.js";
import type {
    <% input_import_names %>
} from "./inputs.js";
<%- if has_macros %>

/** Generated macro bindings from schema truth (not backend capability intersection). */
export class GeneratedMacros {
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
    }
<%- loop macro in macros_view %>

    async <% macro.name %>(<% macro.param_signature %>): Promise<<% macro.ts_return %>> {
        const synthesis = synthesizeMacroCall("<% macro.name %>", [<% macro.param_names %>]);
        const request = buildDeclaredOperationRequest("<% macro.name %>", synthesis);
<%- if macro.uses_execute %>
        const envelope = await this.executor.executeUnit(request);
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
<%- else %>
        const envelope = await this.executor.execute(request);
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value as <% macro.ts_return %>;
<%- end if %>
    }
<%- end loop %>
}
<%- else %>

/** Schema macros (empty for this project). */
export class GeneratedMacros {
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
    }
}
<%- end if %>
<%- loop table in tables_view %>

export class <% table.name %>Delegate {
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
    }

    async findMany<const A extends <% table.name %>FindManyArgs>(
        args?: A,
    ): Promise<ReadonlyArray<<% table.name %>GetPayload<A>>> {
        const synthesis = synthesizeFindMany("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findMany", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value as ReadonlyArray<<% table.name %>GetPayload<A>>;
    }

    async findFirst<const A extends <% table.name %>FindFirstArgs>(
        args?: A,
    ): Promise<<% table.name %>GetPayload<A> | null> {
        const synthesis = synthesizeFindFirst("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findFirst", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        const rows = envelope.value;
        return (rows[0] ?? null) as <% table.name %>GetPayload<A> | null;
    }

    async findUnique<const A extends <% table.name %>FindUniqueArgs>(
        args: A,
    ): Promise<<% table.name %>GetPayload<A> | null> {
        const synthesis = synthesizeFindUnique("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findUnique", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        const rows = envelope.value;
        return (rows[0] ?? null) as <% table.name %>GetPayload<A> | null;
    }

    async create<const A extends <% table.name %>CreateArgs>(
        args: A,
    ): Promise<<% table.name %>GetPayload<A>> {
        const synthesis = synthesizeCreate("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.create", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value[0] as <% table.name %>GetPayload<A>;
    }

    async update<const A extends <% table.name %>UpdateArgs>(
        args: A,
    ): Promise<<% table.name %>GetPayload<A>> {
        const synthesis = synthesizeUpdate("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.update", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value[0] as <% table.name %>GetPayload<A>;
    }

    async delete(args: <% table.name %>DeleteArgs): Promise<void> {
        const synthesis = synthesizeDelete("<% table.name %>", args);
        const envelope = await this.executor.executeUnit(
            buildDeclaredOperationRequest("<% table.name %>.delete", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
    }
}
<%- end loop %>

export class DbClient {
<%- loop table in tables_view %>
    readonly <% table.camel_name %>: <% table.name %>Delegate;
<%- end loop %>
    readonly $macros: GeneratedMacros;
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
        this.$macros = new GeneratedMacros(executor);
<%- loop table in tables_view %>
        this.<% table.camel_name %> = new <% table.name %>Delegate(executor);
<%- end loop %>
    }

    /**
     * Escape hatch for ad-hoc VOS. Prefer generated delegates for typed args and results.
     * @internal
     */
    async $query<T = unknown>(
        source: string,
        parameters?: Readonly<Record<string, unknown>>,
    ): Promise<T> {
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("$query", { source, parameters: parameters ?? {} }),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value as T;
    }

    /** Direct VOS DDL. Success maps VOS unit to void. */
    async $execute(
        source: string,
        parameters?: Readonly<Record<string, unknown>>,
    ): Promise<void> {
        const envelope = await this.executor.executeUnit(
            buildDeclaredOperationRequest("$execute", { source, parameters: parameters ?? {} }),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
    }

    async $close(): Promise<void> {
        await this.executor.close();
    }
}

/** Construct a client from an injected operation executor (preferred ABI). */
export function createClient(executor: OperationExecutor): DbClient {
    return new DbClient(executor);
}
