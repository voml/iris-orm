import type { OperationExecutor } from "./_internal/contract-types.js";
import {
    buildDeclaredOperationRequest,
    evaluateVectorNearRows,
    synthesizeCreate,
    synthesizeDelete,
    synthesizeUpdate,
    synthesizeFindFirst,
    synthesizeFindMany,
    synthesizeFindUnique,
    synthesizeOperationCall,
    synthesizeVectorNear,
    throwOperationEnvelopeError,
} from "./_internal/synthesize.js";
import type {
    <% input_import_names %>
} from "./inputs.js";

/** Raise the author `not_found` failure when a unique `where` matched nothing. */
function throwNotFound(entity: string, operation: string): never {
    throw {
        code: "IRIS-NOT-FOUND",
        kind: "not_found",
        message: `\`${entity}.${operation}\` matched no row`,
    };
}
<% if has_macros %>

/** Generated macro bindings from schema truth (not backend capability intersection). */
export class GeneratedMacros {
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
    }
<% loop macro_view in macros_view %>

    async <% macro_view.name %>(<% macro_view.param_signature %>): Promise<<% macro_view.ts_return %>> {
        const synthesis = synthesizeOperationCall("<% macro_view.name %>", [<% macro_view.param_names %>], [<% macro_view.ref_flags %>]);
        const request = buildDeclaredOperationRequest("<% macro_view.operation_id %>", synthesis);
<% if macro_view.uses_execute %>
        const envelope = await this.executor.executeUnit(request);
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
<% else %>
        const envelope = await this.executor.execute(request);
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value as <% macro_view.ts_return %>;
<% end if %>
    }
<% end loop %>
}
<% else %>

/** Schema macros (empty for this project). */
export class GeneratedMacros {
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
    }
}
<% end if %>
<% loop table in tables_view %>

export class <% table.name %>Delegate {
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
    }

    async findMany<const A extends <% table.name %>FindManyArgs>(
        args?: A,
    ): Promise<ReadonlyArray<<% table.name %>GetPayload<A>>> {
        const synthesis = synthesizeFindMany("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findMany", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value as ReadonlyArray<<% table.name %>GetPayload<A>>;
    }

    async findFirst<const A extends <% table.name %>FindFirstArgs>(
        args?: A,
    ): Promise<<% table.name %>GetPayload<A> | null> {
        const synthesis = synthesizeFindFirst("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findFirst", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        const rows = envelope.value;
        return (rows[0] ?? null) as <% table.name %>GetPayload<A> | null;
    }

    async findUnique<const A extends <% table.name %>FindUniqueArgs>(
        args: A,
    ): Promise<<% table.name %>GetPayload<A> | null> {
        const synthesis = synthesizeFindUnique("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findUnique", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        const rows = envelope.value;
        return (rows[0] ?? null) as <% table.name %>GetPayload<A> | null;
    }
<% if table.has_vector %>

    /**
     * Similarity retrieval over a `vector` field: scan the entity (with the
     * optional `where` pre-filter), score every row against `near.vector`
     * under the explicit `near.metric`, keep rows meeting `near.threshold` in
     * the metric's direction and order closest-first. The metric is always
     * required — no storage-layer default exists.
     */
    async findNear(args: <% table.name %>FindNearArgs): Promise<ReadonlyArray<<% table.name %>>> {
        const synthesis = synthesizeVectorNear("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.findNear", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return evaluateVectorNearRows("<% table.name %>", args, envelope.value) as ReadonlyArray<<% table.name %>>;
    }
<% end if %>

    async create<const A extends <% table.name %>CreateArgs>(
        args: A,
    ): Promise<<% table.name %>GetPayload<A>> {
        const synthesis = synthesizeCreate("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.create", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value[0] as <% table.name %>GetPayload<A>;
    }

    async update<const A extends <% table.name %>UpdateArgs>(
        args: A,
    ): Promise<<% table.name %>GetPayload<A>> {
        const matched = await this.executor.execute(
            buildDeclaredOperationRequest(
                "<% table.name %>.findMany",
                synthesizeFindMany("<% table.name %>", { where: args.where, take: 1 }),
            ),
        );
        if (!matched.ok) {
            throwOperationEnvelopeError(matched);
        }
        if (matched.value.length === 0) {
            throwNotFound("<% table.name %>", "update");
        }
        const synthesis = synthesizeUpdate("<% table.name %>", args);
        const envelope = await this.executor.execute(
            buildDeclaredOperationRequest("<% table.name %>.update", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
        return envelope.value[0] as <% table.name %>GetPayload<A>;
    }

    async delete(args: <% table.name %>DeleteArgs): Promise<void> {
        const matched = await this.executor.execute(
            buildDeclaredOperationRequest(
                "<% table.name %>.findMany",
                synthesizeFindMany("<% table.name %>", { where: args.where, take: 1 }),
            ),
        );
        if (!matched.ok) {
            throwOperationEnvelopeError(matched);
        }
        if (matched.value.length === 0) {
            throwNotFound("<% table.name %>", "delete");
        }
        const synthesis = synthesizeDelete("<% table.name %>", args);
        const envelope = await this.executor.executeUnit(
            buildDeclaredOperationRequest("<% table.name %>.delete", synthesis),
        );
        if (!envelope.ok) {
            throwOperationEnvelopeError(envelope);
        }
    }
}
<% end loop %>

/** Entity namespace of one client: `db.tables.<entity>`. */
export type Tables = {
<% loop table in tables_view %>
    readonly <% table.camel_name %>: <% table.name %>Delegate;
<% end loop %>
};

/**
 * One generated client bound to the adapter its DSN selects.
 *
 * Authors call `createClient({ dsn })` from the host entry and then
 * `db.tables.<entity>`; connection, adapter selection and the operation
 * channel never appear here.
 */
export class Client {
    readonly tables: Tables;
    readonly macros: GeneratedMacros;
<% if has_operations %>
    readonly operations: GeneratedOperations;
<% end if %>
    private readonly executor: OperationExecutor;

    constructor(executor: OperationExecutor) {
        this.executor = executor;
        this.tables = {
<% loop table in tables_view %>
            <% table.camel_name %>: new <% table.name %>Delegate(executor),
<% end loop %>
        };
        this.macros = new GeneratedMacros(executor);
<% if has_operations %>
        this.operations = new GeneratedOperations(executor);
<% end if %>
    }

    /**
     * Run `body` inside one transaction: a resolved promise commits, a thrown
     * error rolls back and is rethrown. The callback receives the same client
     * shape, so entity calls inside are identical to calls outside.
     */
    async transaction<T>(body: (tx: Client) => Promise<T>): Promise<T> {
        const begun = await this.executor.begin();
        if (!begun.ok) {
            throwOperationEnvelopeError(begun);
        }
        try {
            const value = await body(this);
            const committed = await this.executor.commit();
            if (!committed.ok) {
                throwOperationEnvelopeError(committed);
            }
            return value;
        } catch (error) {
            await this.executor.rollback();
            throw error;
        }
    }
}
