/** Build-time D1 physical plan artifact (operationId → parameterized SQL). */
export type D1PhysicalPlan = {
    readonly sql: string;
    readonly mode: "read" | "write" | "write-returning";
    readonly paramOrder?: readonly string[];
};

/** Generated physical plans for Cloudflare D1. */
export const IRIS_D1_PLANS: Record<string, D1PhysicalPlan> = {
<% d1_plan_lines %>
};
