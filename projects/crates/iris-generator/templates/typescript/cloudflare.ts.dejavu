import { createIrisOperationExecutor } from "@yydb/iris/cloudflare";
import type { CreateIrisCloudflareExecutorOptions } from "@yydb/iris/cloudflare";
import { createClient, type DbClient } from "./operations.js";
import { IRIS_FIELD_WIRE_NAMES, IRIS_SCHEMA_FINGERPRINT } from "./metadata.js";
import { IRIS_D1_PLANS } from "./_internal/d1-plans.js";

/** Cloudflare Worker host: D1-backed operation executor with build-time read plans. */
export class Database {
    static async create(options: CreateIrisCloudflareExecutorOptions): Promise<DbClient> {
        return createClient(
            await createIrisOperationExecutor({
                ...options,
                plans: IRIS_D1_PLANS,
                wireNamesByEntity: IRIS_FIELD_WIRE_NAMES,
                contractFingerprint: IRIS_SCHEMA_FINGERPRINT,
            }),
        );
    }
}

export { createClient, DbClient } from "./operations.js";
