{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": {
            "@iris/*": ["server/generated/iris/*"]
        },
        "types": ["node"]
    },
    "include": ["server/**/*.ts", "nuxt.config.ts", "app.vue"]
}
