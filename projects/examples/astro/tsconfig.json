{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@iris/*": ["src/generated/iris/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.astro", "astro.config.mjs", "iris.config.ts"]
}
