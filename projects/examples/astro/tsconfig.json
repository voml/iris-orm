{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@iris/*": ["src/generated/iris/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.astro", "astro.config.mjs"]
}
