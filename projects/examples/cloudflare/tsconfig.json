{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "lib": ["ES2022"],
        "types": ["@cloudflare/workers-types", "node"],
        "baseUrl": ".",
        "paths": {
            "@iris/*": ["src/generated/iris/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "worker-configuration.d.ts", "iris.config.ts"]
}
