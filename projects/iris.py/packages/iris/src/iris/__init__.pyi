"""Type stub for the `iris` Python binding."""

from __future__ import annotations

from typing import Any, TypedDict

class IrisErrorInfo(TypedDict):
    """Structured failure carried by a session envelope."""

    code: str
    message: str

class SessionResult(TypedDict):
    """Result of one session operation."""

    ok: bool
    rows: list[dict[str, Any]]
    error: IrisErrorInfo | None

class IrisError(Exception):
    """Base error raised by the Iris Python binding."""

    code: str

class Session:
    """Iris session bound to a reference or foreign adapter."""

    def query(self, source: str, parameters_json: str | None = None) -> SessionResult: ...
    def execute(self, source: str, parameters_json: str | None = None) -> SessionResult: ...
    def executeOperation(self, request_json: str) -> SessionResult: ...
    def managedPush(self, schema: str) -> SessionResult: ...
    def begin(self) -> SessionResult: ...
    def commit(self) -> SessionResult: ...
    def rollback(self) -> SessionResult: ...
    def sqliteEngineVersion(self) -> str: ...
    def sqliteSourceId(self) -> str: ...
    def close(self) -> None: ...

def version() -> str: ...
def contract_version() -> str: ...
def capabilities() -> list[str]: ...
def openMemory() -> Session: ...
def openSqlite(path: str = ":memory:") -> Session: ...
def openYydb(path: str = ":memory:") -> Session: ...
def openPostgres(url: str) -> Session: ...
def openMysql(url: str) -> Session: ...
