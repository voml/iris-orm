{
    "name": "@yydb/iris-orm-workspace",
    "private": true,
    "description": "Iris ORM — VOS data-access layer. One Rust semantic core; Node via N-API, browsers via WASM.",
    "homepage": "https://iris-orm.pages.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/iris-orm.git"
    },
    "bugs": {
        "url": "https://github.com/voml/iris-orm/issues"
    },
    "packageManager": "pnpm@10.0.0",
    "type": "module",
    "scripts": {
        "fmt": "node scripts/format.mjs",
        "fmt:check": "node scripts/format.mjs --check",
        "check:rs": "node scripts/check-rs.mjs",
        "test:rs": "node scripts/test-rs.mjs",
        "typecheck:ts": "node scripts/typecheck-ts.mjs",
        "iris": "pnpm --filter @yydb/iris exec node ./bin/iris.ts",
        "napi:build": "pnpm --filter @yydb/iris-napi build",
        "wasm:build": "pnpm --filter @yydb/iris-wasm build",
        "test:ts": "pnpm -r --filter @yydb/iris --filter @yydb/iris-unknown-wasm32 --filter @yydb/iris-napi run test",
        "homepage": "pnpm --filter @yydb/iris-homepage build",
        "homepage:dev": "pnpm --filter @yydb/iris-homepage dev",
        "homepage:build": "pnpm homepage",
        "homepage:check": "pnpm --filter @yydb/iris-homepage check",
        "verify:homepage-hosts": "pnpm --filter @yydb/iris-homepage run verify:hosts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.8",
        "typescript": "^5.9.2"
    }
}
