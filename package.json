{
    "name": "@yydb/iris-orm-workspace",
    "private": true,
    "description": "Iris ORM — VOS data-access layer. One Rust semantic core; Node via N-API, browsers via WASM.",
    "homepage": "https://iris-orm.pages.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/iris-orm.git"
    },
    "bugs": {
        "url": "https://github.com/voml/iris-orm/issues"
    },
    "packageManager": "pnpm@10.0.0",
    "type": "module",
    "engines": {
        "node": ">=24.12.0"
    },
    "scripts": {
        "fmt": "nifty format",
        "fmt:check": "nifty format --check",
        "check:rs": "node scripts/check-rs.mjs",
        "test:rs": "node scripts/test-rs.mjs",
        "typecheck:ts": "node scripts/typecheck-ts.mjs",
        "test:ci": "node --test \"scripts/ci/*.test.mjs\"",
        "iris": "pnpm --filter @yydb/iris run build && node ./projects/iris.ts/packages/iris/bin/iris.mjs",
        "build:ts": "pnpm --filter @yydb/iris-unknown-wasm32 build && pnpm --filter @yydb/iris build && pnpm --filter @yydb/iris-language build",
        "build:napi": "node scripts/build-napi.mjs",
        "build:wasm": "node scripts/build-wasm.mjs",
        "napi:build": "node scripts/build-napi.mjs",
        "wasm:build": "node scripts/build-wasm.mjs",
        "test:ts": "pnpm build:ts && pnpm -r --filter @yydb/iris --filter @yydb/iris-unknown-wasm32 --filter @yydb/iris-language run test",
        "homepage": "pnpm --filter @yydb/iris-homepage build",
        "homepage:dev": "pnpm --filter @yydb/iris-homepage dev",
        "homepage:build": "pnpm homepage",
        "homepage:check": "pnpm --filter @yydb/iris-homepage check",
        "verify:homepage-hosts": "pnpm --filter @yydb/iris-homepage run verify:hosts",
        "examples:generate": "node scripts/generate-examples.mjs",
        "examples:typecheck": "pnpm -r --filter \"@yydb-examples/*\" run typecheck",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.9",
        "@napi-rs/cli": "^3.10.6",
        "typescript": "^5.9.2",
        "@types/node": "^22.15.0"
    }
}
